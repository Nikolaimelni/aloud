{
  "name": "aloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @aloud/app run start",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "pnpm --filter @aloud/bench run bench"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@0.5": "^0.6.1",
      "brace-expansion@5": "^5.0.12",
      "fast-uri@3": "^3.1.8",
      "ip-address@10": "^10.7.1",
      "piscina@5": "^5.3.2",
      "sharp@0.34": "^0.35.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "@parcel/watcher"
    ]
  }
}
