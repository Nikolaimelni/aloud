{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/favicon.svg",
          "/apple-touch-icon.png",
          "/*.css",
          "/*.js",
          "/worklets/**"
        ]
      }
    },
    {
      "name": "runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/ort/**"]
      }
    }
  ]
}
